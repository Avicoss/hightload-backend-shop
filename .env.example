# PostgreSQL
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=shop_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# RabbitMQ
RABBITMQ_USER=shop_user
RABBITMQ_PASSWORD=rabbit_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# JWT
JWT_SECRET_KEY=your-super-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Outbox Worker
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRIES=5
# Сколько минут событие может висеть в статусе processing до сброса в pending
OUTBOX_STUCK_THRESHOLD_MINUTES=5
